# ============================================================
# Application Configuration
# ============================================================

APP_NAME=Cloud Document Management System
APP_ENV=development
SECRET_KEY=replace-with-a-secure-secret

# ============================================================
# PostgreSQL Database
# ============================================================

DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/aws_azure_document_migration

# ============================================================
# Storage Configuration
# Valid values: local, s3, azure
# ============================================================

STORAGE_PROVIDER=local

# Local development storage
LOCAL_STORAGE_PATH=local-storage

# ============================================================
# AWS Configuration
# Used when STORAGE_PROVIDER=s3
# ============================================================

AWS_REGION=us-east-1
S3_BUCKET_NAME=replace-with-s3-bucket-name

# ============================================================
# Azure Configuration
# Used when STORAGE_PROVIDER=azure
# ============================================================

AZURE_STORAGE_ACCOUNT=replace-with-storage-account-name
AZURE_STORAGE_CONTAINER=documents

# ============================================================
# Upload Configuration
# ============================================================

MAX_UPLOAD_SIZE_MB=10